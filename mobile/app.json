{
  "expo": {
    "name": "Чек-лист инженера",
    "slug": "checklist-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "checklist",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.checkonout.mobile"
    },
    "android": {
      "package": "ru.checkonout.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Разрешите доступ к камере для фотофиксации оборудования."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Разрешите доступ к геолокации для фиксации местоположения визита."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Разрешите использование биометрии для входа в приложение."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите доступ к фото для выбора изображений."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "869c2b2e-8164-4ea0-834f-64bdef31e7df"
      }
    },
    "owner": "nosferatu1904"
  }
}
